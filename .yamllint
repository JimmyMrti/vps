---
extends: default

rules:
  line-length:
    max: 160
    level: warning
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  # Les deux règles ci-dessous sont imposées par ansible-lint : les laisser
  # diverger fait perdre le mode correction automatique.
  comments-indentation: false
  comments:
    min-spaces-from-content: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  braces:
    max-spaces-inside: 1

ignore: |
  .github/
  ansible/collections/

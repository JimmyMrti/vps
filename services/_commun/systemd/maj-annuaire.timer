[Unit]
Description=Verifie toutes les dix minutes si une nouvelle version de l'annuaire est publiee

[Timer]
OnBootSec=5min
OnUnitActiveSec=10min
# Evite d'interroger le registre a la meme seconde que les autres services.
RandomizedDelaySec=60
Persistent=true
Unit=maj-annuaire.service

[Install]
WantedBy=timers.target

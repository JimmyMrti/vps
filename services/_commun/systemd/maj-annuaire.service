[Unit]
Description=Mise a jour de l'annuaire artisans
Documentation=https://github.com/jimmymrti/vps
After=docker.service network-online.target
Requires=docker.service
OnFailure=alerte@%n.service

[Service]
Type=oneshot
ExecStart=/opt/vps/services/annuaire/maj.sh
# Les migrations peuvent etre longues sur une grosse table ; au-dela, quelque
# chose ne va pas.
TimeoutStartSec=1800

# Emplacement impose par le durcissement ci-dessous, qui masque /home ET /root :
# un `docker login` ordinaire serait introuvable pour root.
Environment=DOCKER_CONFIG=/etc/docker/identifiants

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/vps/services/annuaire
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

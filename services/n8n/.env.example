# ---------------------------------------------------------------------------
# À copier en .env dans /opt/vps/services/n8n/, en 0600 root:root.
# Aucun secret ici : ils vivent dans /opt/vps/secrets/n8n/.
# ---------------------------------------------------------------------------

# Version explicite, jamais `latest` : une mise à jour majeure de n8n peut
# migrer la base sans retour possible. Relever la version du jour sur
# https://github.com/n8n-io/n8n/releases et la fixer ici.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:1.XX.X

# --- Adressage : deux cas, un seul actif -------------------------------------
#
# n8n détient les jetons d'accès de tout ce qu'il pilote. Il ne s'expose que
# s'il doit recevoir des appels entrants (webhooks, formulaires) ; tout le
# reste — déclencheurs programmés, appels sortants — fonctionne sans aucune
# exposition. Voir docs/services/n8n.md.

# CAS 1 — rien d'exposé (par défaut). Accès par tunnel SSH :
#   ssh -L 5678:localhost:5678 ubuntu@VPS   puis   http://localhost:5678
N8N_DOMAIN=
N8N_PROTOCOL=http
N8N_URL_EDITEUR=http://localhost:5678
N8N_URL_WEBHOOK=http://localhost:5678
N8N_COOKIE_SECURISE=false
N8N_SAUTS_PROXY=0

# CAS 2 — les webhooks exposés, l'éditeur toujours par tunnel.
# Commenter le cas 1 et décommenter les six lignes ci-dessous.
#
# C'est là que se fait la dissociation demandée : le domaine ci-dessous ne
# sert QUE les chemins d'appel entrant, et l'éditeur n'a aucune adresse
# publique. Les deux URL sont donc différentes, ce que n8n sait faire :
# N8N_URL_WEBHOOK fabrique les adresses à donner aux services tiers,
# N8N_URL_EDITEUR celles des liens internes.
#
# Le domaine est un domaine distinct dédié à l'infrastructure, avec une
# étiquette aléatoire (`openssl rand -hex 4`), jamais un sous-domaine de
# preventioncambriolage.fr. Le nom fourni par OVH (vpsXXXXXX.vps.ovh.net) ne
# convient pas : son quota de certificats Let's Encrypt est partagé avec tous
# les VPS OVH, et il change avec la machine.
#
# N8N_DOMAIN=k7m2x9qp.exemple-infra.ovh
# N8N_PROTOCOL=https
# N8N_URL_WEBHOOK=https://k7m2x9qp.exemple-infra.ovh
# # L'éditeur reste joint par le tunnel : son URL ne change pas.
# N8N_URL_EDITEUR=http://localhost:5678
# # Le cookie de session ne traverse jamais le réseau — la page de connexion
# # n'est pas servie sur le domaine public, le frontal y répond 404.
# N8N_COOKIE_SECURISE=false
# # Un seul proxy devant n8n pour le trafic de webhook (Caddy). Sans ce
# # réglage, n8n attribue tous les appels à l'adresse de Caddy : limitation de
# # débit inopérante et journaux sans valeur.
# N8N_SAUTS_PROXY=1

# Adresses autorisées à atteindre l'interface et l'API REST. Les webhooks, eux,
# restent publics : c'est leur raison d'être.
#
# Vide = interface fermée à tout le monde. C'est le réglage par défaut, et il
# est utilisable : on passe alors par un tunnel SSH.
#   ssh -L 5678:localhost:5678 ubuntu@VPS   puis   http://localhost:5678
#
# Sinon, une liste séparée par des espaces, au format Caddy :
#   N8N_IP_ADMIN=203.0.113.4 2001:db8::/32
N8N_IP_ADMIN=

# --- Secrets à créer sur la machine, hors dépôt -----------------------------
#
#   install -d -m 0700 -o root -g root /opt/vps/secrets/n8n
#
#   openssl rand -hex 32 > /opt/vps/secrets/n8n/mdp_postgres
#   chmod 600 /opt/vps/secrets/n8n/mdp_postgres
#
#   printf 'N8N_ENCRYPTION_KEY=%s\n' "$(openssl rand -hex 32)" \
#     > /opt/vps/secrets/n8n/chiffrement.env
#   chmod 600 /opt/vps/secrets/n8n/chiffrement.env
#
# La clé de chiffrement doit être recopiée dans un gestionnaire de mots de
# passe, hors du serveur. Sans elle, les sauvegardes de n8n ne valent rien ; si
# elle change, tous les identifiants enregistrés sont à ressaisir.

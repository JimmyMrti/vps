# ---------------------------------------------------------------------------
# À copier en .env dans /opt/vps/services/annuaire/, en 0600 root:root.
# Aucun secret ici : ils vivent dans /opt/vps/secrets/annuaire/.
# ---------------------------------------------------------------------------

# Image construite en intégration continue, jamais sur le VPS. Version
# explicite : `latest` empêche de savoir ce qui tourne et de revenir en arrière.
ANNUAIRE_IMAGE=ghcr.io/jimmymrti/annuaire:0.1.0

# Commande de migration de schéma, exécutée à la main avant chaque démarrage :
#   docker compose --profile migration run --rm migration
ANNUAIRE_MIGRATION_CMD=npm run migrate

# Domaine servi par Caddy. Tant qu'il est vide, edge/sites/annuaire.caddy ne
# sert rien et le site n'existe pas. Un domaine propre est recommandé plutôt
# qu'un sous-domaine de preventioncambriolage.fr — voir docs/services/annuaire.md.
ANNUAIRE_DOMAIN=

# Ouverture à l'indexation. 0 = robots.txt interdit tout et chaque page porte
# une balise noindex. Même mécanique que le site statique : un site en mise au
# point indexé par erreur est long à rattraper.
ANNUAIRE_INDEXABLE=0

# Le temps de la mise au point, on peut aussi réserver le site à quelques
# adresses en décommentant le bloc prévu dans edge/sites/annuaire.caddy.
ANNUAIRE_IP_PRIVE=

# --- Secrets à créer sur la machine, hors dépôt -----------------------------
#
#   install -d -m 0700 -o root -g root /opt/vps/secrets/annuaire
#
#   openssl rand -hex 32 > /opt/vps/secrets/annuaire/mdp_postgres
#   chmod 600 /opt/vps/secrets/annuaire/mdp_postgres
#
#   cat > /opt/vps/secrets/annuaire/annuaire.env <<'EOF'
#   DATABASE_URL=postgresql://annuaire:LE_MOT_DE_PASSE@annuaire-db:5432/annuaire
#   SESSION_SECRET=...
#   EOF
#   chmod 600 /opt/vps/secrets/annuaire/annuaire.env
#
# Le mot de passe apparaît en clair dans DATABASE_URL parce que la plupart des
# bibliothèques d'accès ne savent lire qu'une URL. C'est pour cela que ce
# fichier est en 0600 root:root et qu'il ne sort jamais de la machine.

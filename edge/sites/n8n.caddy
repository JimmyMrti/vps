# n8n — deux portes derrière la même adresse.
#
# Les webhooks doivent être joignables depuis n'importe où : c'est leur raison
# d'être. L'interface d'administration et l'API REST, non. La séparation se
# fait ici, au frontal, et pas dans n8n : une faille d'authentification dans
# n8n ne doit pas suffire à entrer.
#
# Voir docs/services/n8n.md.

{$N8N_DOMAIN:n8n.localhost} {
	import entetes_securite
	import journal_acces

	encode zstd gzip

	# Ce qui doit rester public, et rien d'autre.
	@public path /webhook/* /webhook-test/* /webhook-waiting/* /form/* /form-waiting/* /healthz

	handle @public {
		reverse_proxy n8n:5678
	}

	# Tout le reste : interface, /rest/*, /api/*.
	#
	# La valeur par défaut est une adresse de documentation (RFC 5737), jamais
	# attribuée à un client réel : sans N8N_IP_ADMIN renseigné, l'interface est
	# fermée à tout le monde. On y accède alors par un tunnel SSH, ce qui est
	# la configuration la plus sûre :
	#
	#   ssh -L 5678:localhost:5678 ubuntu@VPS   puis   http://localhost:5678
	handle {
		@hors_liste not remote_ip {$N8N_IP_ADMIN:192.0.2.1}
		# 404 plutôt que 403 : inutile de confirmer à un inconnu qu'il y a
		# quelque chose derrière cette adresse.
		respond @hors_liste 404

		reverse_proxy n8n:5678
	}

	# Un n8n indexé par un moteur de recherche est un n8n qu'on trouve sans
	# chercher.
	header X-Robots-Tag "noindex, nofollow"
}

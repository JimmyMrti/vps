# {{ ansible_managed }}
#
# Variables lues par les fichiers edge/sites/*.caddy.
# Le contrat est décrit dans edge/sites/README.md.
#
# Les valeurs vides sont volontairement laissées vides : les fichiers de site
# retombent alors sur des valeurs qui échouent du bon côté — un nom en
# .localhost (certificat interne, rien demandé à Let's Encrypt) et une liste
# d'adresses qui n'ouvre à personne.

SITE_DOMAIN={{ proxy_domaine_site }}

N8N_DOMAIN={{ proxy_domaine_n8n }}
N8N_IP_ADMIN={{ proxy_n8n_ip_admin }}

ANNUAIRE_DOMAIN={{ proxy_domaine_annuaire }}
ANNUAIRE_IP_PRIVE={{ proxy_annuaire_ip_prive }}
